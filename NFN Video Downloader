<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>NFN Downloader - Free Online Video Downloader</title>

<meta name="description"
content="NFN Downloader lets you download supported online videos and convert media easily.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,Arial,sans-serif;
    background:#fff;
    color:#222;
    overflow-x:hidden;
}

button,
input,
select{
    font-family:inherit;
}

button{
    cursor:pointer;
}

a{
    text-decoration:none;
    color:inherit;
}


/* =========================================================
   COLORS
========================================================= */

:root{
    --green:#70d400;
    --green-dark:#52ad00;
    --green-light:#f0fae8;
    --border:#e6e6e6;
    --text:#282828;
    --muted:#777;
}


/* =========================================================
   HEADER
========================================================= */

.header{
    height:72px;
    border-bottom:1px solid #e9e9e9;
    background:#fff;
    position:sticky;
    top:0;
    z-index:1000;
}

.header-inner{
    max-width:1050px;
    height:100%;
    margin:auto;
    padding:0 20px;

    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:30px;
    font-weight:800;
    letter-spacing:-1.8px;
    color:#20252b;
}

.logo span{
    color:var(--green-dark);
}

.menu-button{
    width:44px;
    height:44px;
    border:0;
    background:transparent;

    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:6px;
}

.menu-button span{
    width:28px;
    height:3px;
    border-radius:4px;
    background:#333;
    display:block;
}


/* =========================================================
   SIDE MENU
========================================================= */

.overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.38);
    z-index:1999;
    display:none;
}

.overlay.active{
    display:block;
}

.side-menu{
    position:fixed;
    top:0;
    left:-310px;

    width:290px;
    height:100vh;

    background:#fff;

    z-index:2000;

    box-shadow:8px 0 30px rgba(0,0,0,.15);

    transition:.3s ease;

    overflow-y:auto;
}

.side-menu.active{
    left:0;
}

.menu-header{
    height:72px;
    border-bottom:1px solid #eee;

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:0 20px;
}

.menu-title{
    font-size:20px;
    font-weight:800;
}

.close-menu{
    border:0;
    background:none;
    font-size:30px;
    color:#555;
}

.menu-section{
    padding:20px 22px 8px;

    color:#888;

    font-size:11px;
    font-weight:700;

    text-transform:uppercase;

    letter-spacing:1px;
}

.menu-links{
    padding:12px 0;
}

.menu-links a{
    display:block;

    padding:17px 22px;

    font-size:15px;

    color:#333;

    border-bottom:1px solid #f4f4f4;
}

.menu-links a:hover{
    background:#f5fbeF;
    color:var(--green-dark);
}


/* =========================================================
   HERO
========================================================= */

.hero{
    max-width:850px;

    margin:auto;

    text-align:center;

    padding:42px 18px 25px;
}


/* =========================================================
   TINY GREEN DOWNLOAD LOGO
========================================================= */

.download-icon{
    width:42px;
    height:42px;

    margin:0 auto 18px;

    position:relative;

    display:flex;
    align-items:center;
    justify-content:center;
}

.arrow{
    width:21px;
    height:28px;

    position:relative;

    background:#78d900;

    border-radius:2px 2px 0 0;

    box-shadow:
        inset 2px 0 rgba(255,255,255,.18),
        inset -2px 0 rgba(0,0,0,.08);
}

.arrow:before{
    content:"";

    position:absolute;

    left:-7px;
    bottom:-9px;

    width:0;
    height:0;

    border-left:17px solid transparent;
    border-right:17px solid transparent;
    border-top:19px solid #69c900;
}

.arrow:after{
    content:"";

    position:absolute;

    left:-10px;
    top:1px;

    width:10px;
    height:15px;

    border-right:4px solid #8bea12;
    border-left:4px solid #8bea12;
}


/* =========================================================
   TITLE
========================================================= */

.hero h1{
    font-size:36px;
    line-height:1.2;

    color:#333;

    font-weight:800;

    margin-bottom:28px;
}

.hero h1 span{
    color:#68c700;
}


/* =========================================================
   SEARCH
========================================================= */

.search-wrapper{
    width:100%;

    display:flex;

    background:var(--green);

    padding:7px;

    border-radius:8px;

    box-shadow:0 4px 14px rgba(80,150,0,.12);
}

.search-input-box{
    position:relative;
    flex:1;
    min-width:0;
}

.search-input{
    width:100%;

    height:62px;

    border:0;
    outline:0;

    background:#fff;

    padding:0 48px 0 17px;

    font-size:17px;

    color:#222;

    border-radius:3px;
}

.search-input::placeholder{
    color:#888;
}


/* =========================================================
   CLEAR X BUTTON
========================================================= */

.clear-input{
    position:absolute;

    right:12px;
    top:50%;

    transform:translateY(-50%);

    width:24px;
    height:24px;

    border-radius:50%;

    border:1px solid #aaa;

    background:#fff;

    color:#777;

    display:none;

    align-items:center;
    justify-content:center;

    font-size:17px;
    font-weight:500;

    line-height:1;

    padding:0;

    z-index:5;
}

.clear-input:hover{
    background:#f1f1f1;
    color:#333;
    border-color:#777;
}

.clear-input.show{
    display:flex;
}


.search-submit{
    width:76px;

    border:0;

    background:var(--green);

    color:#477d00;

    font-size:42px;

    font-weight:700;
}

.search-submit:hover{
    color:#285700;
}


/* =========================================================
   ACCEPT
========================================================= */

.accept-text{
    margin:15px auto 0;

    max-width:650px;

    font-size:14px;

    line-height:1.7;

    color:#555;
}

.accept-text a{
    color:#277a98;
    text-decoration:underline;
}


/* =========================================================
   TRUST
========================================================= */

.trust{
    text-align:center;

    margin:42px auto 20px;
}

.security{
    display:inline-flex;

    align-items:center;

    gap:9px;

    font-size:14px;

    color:#333;
}

.security-icon{
    width:29px;
    height:29px;

    border-radius:50%;

    border:4px solid #f5d400;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:13px;
    font-weight:800;
}

.rating{
    margin-top:27px;

    font-size:15px;

    color:#555;
}

.stars{
    color:#eaaa1c;

    font-size:24px;

    letter-spacing:2px;
}

.rating strong{
    color:#333;
    font-size:18px;
}


/* =========================================================
   PROCESSING
========================================================= */

.processing{
    max-width:850px;

    margin:20px auto;

    padding:0 18px;

    display:none;
}

.processing.active{
    display:block;
}

.processing-box{
    background:#f4faee;

    border:1px solid #d8ebc9;

    border-radius:8px;

    padding:18px;
}

.processing-title{
    font-size:15px;

    font-weight:700;

    color:#333;
}

.processing-text{
    font-size:12px;

    color:#777;

    margin-top:6px;
}


/* MOVING DOTS */

.dots{
    margin-top:13px;

    display:flex;

    align-items:center;

    gap:5px;
}

.dot{
    width:7px;
    height:7px;

    border-radius:50%;

    background:#6e9eaa;

    animation:dotMove 1.2s infinite ease-in-out;
}

.dot:nth-child(2){
    animation-delay:.15s;
}

.dot:nth-child(3){
    animation-delay:.30s;
}

.dot:nth-child(4){
    animation-delay:.45s;
}

@keyframes dotMove{

    0%,60%,100%{
        transform:translateX(0);
        opacity:.35;
    }

    30%{
        transform:translateX(7px);
        opacity:1;
    }
}


/* =========================================================
   RESULT
========================================================= */

.result{
    max-width:850px;

    margin:25px auto;

    padding:0 18px;

    display:none;
}

.result.active{
    display:block;
}


/* screenshot-style result */

.video-result{
    width:100%;

    border:1px solid #ddd;

    background:#fff;

    overflow:hidden;

    box-shadow:0 1px 4px rgba(0,0,0,.08);
}


/* RESULT TOP */

.video-heading{
    text-align:center;

    font-size:20px;

    font-weight:600;

    padding:20px 10px 75px;

    color:#333;
}


/* PREVIEW */

.video-preview{
    position:relative;

    width:100%;

    height:330px;

    background:#dfe7ea;

    overflow:hidden;
}

.video-preview img{
    width:100%;
    height:100%;

    object-fit:cover;

    display:none;
}

.video-preview.has-image img{
    display:block;
}

.preview-placeholder{
    width:100%;
    height:100%;

    display:flex;
    align-items:center;
    justify-content:center;

    background:
        linear-gradient(
            135deg,
            #dce5e7,
            #aebec3
        );

    color:#777;

    font-size:13px;
}


/* =========================================================
   DOWNLOAD CONTROL
========================================================= */

.download-control{
    position:absolute;

    top:-41px;

    left:50%;

    transform:translateX(-50%);

    display:flex;

    height:64px;

    border-radius:8px;

    overflow:visible;

    box-shadow:0 3px 10px rgba(0,0,0,.16);

    z-index:10;
}

.download-main{
    height:64px;

    min-width:125px;

    border:0;

    background:#08a935;

    color:white;

    font-size:20px;

    font-weight:600;

    border-radius:8px 0 0 8px;
}

.quality-wrap{
    position:relative;

    height:64px;
}

.quality-button{
    height:64px;

    min-width:235px;

    border:0;

    border-left:1px solid rgba(0,0,0,.12);

    background:#fff;

    color:#119d38;

    padding:0 18px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:18px;

    font-size:20px;

    border-radius:0 8px 8px 0;
}

.quality-arrow{
    font-size:27px;

    color:#0e9c35;

    transition:.2s;
}

.quality-button.open .quality-arrow{
    transform:rotate(180deg);
}


/* QUALITY MENU */

.quality-menu{
    position:absolute;

    top:69px;

    right:0;

    width:235px;

    background:white;

    border:3px solid #08a935;

    border-radius:7px;

    overflow:hidden;

    box-shadow:0 4px 15px rgba(0,0,0,.18);

    display:none;

    z-index:50;
}

.quality-menu.active{
    display:block;
}

.quality-option{
    width:100%;

    height:57px;

    border:0;

    background:#fff;

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 28px;

    color:#149e3c;

    font-size:18px;
}

.quality-option:hover{
    background:#f0fae9;
}

.quality-option span:last-child{
    color:#999;
}


/* VIDEO TITLE */

.video-title{
    padding:42px 25px 24px;

    font-size:20px;

    color:#666;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;

    border-bottom:1px solid #eee;
}


/* DOWNLOAD STATUS */

.download-status{
    display:none;

    padding:15px 20px;

    background:#eaf8df;

    color:#418c18;

    font-size:13px;

    text-align:center;
}

.download-status.active{
    display:block;
}


/* =========================================================
   RESOURCES
========================================================= */

.resources{
    max-width:850px;

    margin:65px auto;

    padding:0 18px;
}

.section-title{
    font-size:29px;

    font-weight:800;

    margin-bottom:25px;

    color:#292d31;
}

.section-subtitle{
    color:#777;

    font-size:14px;

    margin-top:-17px;

    margin-bottom:25px;
}


/* POPULAR */

.popular-list{
    display:flex;

    flex-direction:column;

    gap:14px;
}

.resource-card{
    min-height:80px;

    border-radius:10px;

    background:#eef9e8;

    display:flex;

    align-items:center;

    padding:13px 22px;

    gap:18px;

    transition:.2s;

    border:1px solid transparent;
}

.resource-card:hover{
    border-color:#c8e8b6;

    transform:translateY(-1px);
}

.resource-icon{
    width:52px;
    height:52px;

    border-radius:11px;

    background:white;

    display:flex;

    align-items:center;
    justify-content:center;

    font-size:25px;

    font-weight:800;

    flex-shrink:0;
}

.resource-name{
    font-size:17px;

    font-weight:500;
}

.resource-domain{
    font-size:11px;

    color:#777;

    margin-top:4px;
}


/* ALL RESOURCES */

.all-title{
    margin-top:60px;
}

.all-grid{
    display:grid;

    grid-template-columns:1fr 1fr;

    gap:10px 35px;
}

.all-resource{
    display:flex;

    align-items:center;

    gap:15px;

    padding:12px 8px;

    border-bottom:1px solid #f0f0f0;

    min-height:67px;
}

.all-icon{
    width:43px;
    height:43px;

    border-radius:9px;

    background:#edf1f4;

    display:flex;

    align-items:center;
    justify-content:center;

    font-size:18px;

    font-weight:700;

    flex-shrink:0;
}

.all-name{
    font-size:15px;

    color:#333;
}

.all-description{
    font-size:10px;

    color:#999;

    margin-top:3px;
}


/* =========================================================
   CONVERTERS
========================================================= */

.converter-grid{
    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:10px 25px;
}

.converter{
    min-height:64px;

    display:flex;

    align-items:center;

    gap:14px;

    border-bottom:1px solid #eee;
}

.converter-icon{
    width:48px;
    height:48px;

    border-radius:9px;

    background:#263644;

    color:#fff;

    display:flex;

    align-items:center;
    justify-content:center;

    font-size:10px;

    font-weight:800;

    flex-shrink:0;
}

.converter-name{
    font-size:14px;

    color:#333;
}


/* =========================================================
   HOW TO
========================================================= */

.howto{
    background:#f7faf5;

    padding:60px 18px;

    margin-top:60px;
}

.howto-inner{
    max-width:850px;

    margin:auto;
}

.steps{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:15px;
}

.step{
    background:white;

    border:1px solid #e7eee2;

    border-radius:10px;

    padding:22px;
}

.step-number{
    width:35px;
    height:35px;

    border-radius:50%;

    background:#6bd000;

    color:white;

    display:flex;

    align-items:center;
    justify-content:center;

    font-weight:800;

    margin-bottom:15px;
}

.step h3{
    font-size:14px;
}

.step p{
    font-size:12px;

    color:#777;

    line-height:1.7;

    margin-top:8px;
}


/* =========================================================
   ADSTERRA AREA
========================================================= */

.ad-container{
    max-width:850px;

    margin:35px auto;

    padding:0 18px;

    text-align:center;
}

.ad-label{
    font-size:9px;

    color:#aaa;

    margin-bottom:7px;

    text-transform:uppercase;

    letter-spacing:1px;
}


/* =========================================================
   FOOTER
========================================================= */

footer{
    border-top:1px solid #eee;

    padding:35px 20px;

    text-align:center;

    color:#888;

    font-size:12px;
}

.footer-logo{
    font-size:22px;

    font-weight:800;

    color:#333;

    margin-bottom:8px;
}

.footer-logo span{
    color:#69c900;
}

.footer-links{
    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:18px;

    margin-top:16px;
}

.footer-links a{
    color:#666;
}

.footer-links a:hover{
    color:#5caf00;
}


/* =========================================================
   TOAST
========================================================= */

.toast{
    position:fixed;

    left:50%;
    bottom:22px;

    transform:translate(-50%,25px);

    background:#222;

    color:white;

    padding:12px 17px;

    border-radius:7px;

    font-size:12px;

    opacity:0;

    pointer-events:none;

    transition:.25s;

    z-index:3000;

    max-width:90%;

    text-align:center;
}

.toast.show{
    opacity:1;

    transform:translate(-50%,0);
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:650px){

    .header{
        height:65px;
    }

    .logo{
        font-size:27px;
    }

    .hero{
        padding-top:35px;
    }

    .download-icon{
        width:42px;
        height:42px;

        transform:scale(.82);

        margin-bottom:3px;
    }

    .hero h1{
        font-size:29px;

        margin-bottom:22px;
    }

    .search-wrapper{
        padding:6px;
    }

    .search-input{
        height:58px;

        font-size:15px;
    }

    .clear-input{
        right:10px;
        width:23px;
        height:23px;
        font-size:16px;
    }

    .search-submit{
        width:65px;

        font-size:34px;
    }

    .accept-text{
        font-size:12px;
    }

    .trust{
        margin-top:35px;
    }

    .rating{
        margin-top:22px;
    }

    .resources{
        margin-top:50px;
    }

    .section-title{
        font-size:25px;
    }

    .resource-card{
        min-height:74px;

        padding:11px 15px;
    }

    .resource-icon{
        width:45px;
        height:45px;

        font-size:21px;
    }

    .resource-name{
        font-size:15px;
    }

    .all-grid{
        grid-template-columns:1fr;

        gap:0;
    }

    .converter-grid{
        grid-template-columns:1fr;
    }

    .steps{
        grid-template-columns:1fr;
    }

    /* RESULT MOBILE */

    .video-heading{
        font-size:19px;

        padding-bottom:70px;
    }

    .video-preview{
        height:250px;
    }

    .download-control{
        height:57px;

        top:-36px;
    }

    .download-main{
        height:57px;

        min-width:105px;

        font-size:17px;
    }

    .quality-button{
        height:57px;

        min-width:165px;

        font-size:16px;

        padding:0 12px;
    }

    .quality-menu{
        width:165px;
    }

    .quality-option{
        height:51px;

        padding:0 15px;

        font-size:15px;
    }

    .video-title{
        padding:38px 15px 20px;

        font-size:16px;
    }

}

@media(max-width:380px){

    .search-input{
        font-size:13px;
    }

    .search-submit{
        width:57px;
    }

    .download-main{
        min-width:92px;
    }

    .quality-button{
        min-width:145px;

        font-size:14px;
    }

    .quality-menu{
        width:145px;
    }

}


/* =========================================================
   LOADING OVERLAY INSIDE PREVIEW
========================================================= */

.preview-loading{
    position:absolute;

    inset:0;

    background:rgba(255,255,255,.82);

    display:none;

    align-items:center;

    justify-content:center;

    flex-direction:column;

    gap:10px;

    z-index:5;
}

.preview-loading.active{
    display:flex;
}

.loading-dots{
    display:flex;

    gap:6px;
}

.loading-dots span{
    width:8px;
    height:8px;

    border-radius:50%;

    background:#568da0;

    animation:loadingDot 1.1s infinite;
}

.loading-dots span:nth-child(2){
    animation-delay:.15s;
}

.loading-dots span:nth-child(3){
    animation-delay:.3s;
}

@keyframes loadingDot{

    0%,100%{
        transform:translateY(0);
        opacity:.35;
    }

    50%{
        transform:translateY(-7px);
        opacity:1;
    }

}

</style>
</head>


