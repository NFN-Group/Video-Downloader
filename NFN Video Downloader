<script>

/* =========================================================
   MENU
========================================================= */

function openMenu(){

    document
        .getElementById("sideMenu")
        .classList.add("active");

    document
        .getElementById("overlay")
        .classList.add("active");

}


function closeMenu(){

    document
        .getElementById("sideMenu")
        .classList.remove("active");

    document
        .getElementById("overlay")
        .classList.remove("active");

}


/* =========================================================
   TOAST
========================================================= */

function showToast(message){

    const toast =
        document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    setTimeout(function(){

        toast.classList.remove("show");

    },2500);

}


/* =========================================================
   CLEAR INPUT
========================================================= */

function clearInputField(){

    const input =
        document.getElementById("urlInput");

    input.value = "";

    input.focus();

    document
        .getElementById("clearInput")
        .classList.remove("show");

}


/* =========================================================
   PLATFORM DETECTION
========================================================= */

function detectPlatform(url){

    const value =
        url.toLowerCase();

    if(
        value.includes("youtube.com") ||
        value.includes("youtu.be")
    ){
        return "YouTube";
    }

    if(
        value.includes("tiktok.com") ||
        value.includes("vm.tiktok.com") ||
        value.includes("vt.tiktok.com")
    ){
        return "TikTok";
    }

    if(
        value.includes("instagram.com")
    ){
        return "Instagram";
    }

    if(
        value.includes("facebook.com") ||
        value.includes("fb.watch")
    ){
        return "Facebook";
    }

    if(
        value.includes("twitter.com") ||
        value.includes("x.com")
    ){
        return "X";
    }

    if(
        value.includes("pinterest.com") ||
        value.includes("pin.it")
    ){
        return "Pinterest";
    }

    if(
        value.includes("reddit.com")
    ){
        return "Reddit";
    }

    if(
        value.includes("vimeo.com")
    ){
        return "Vimeo";
    }

    if(
        value.includes("dailymotion.com")
    ){
        return "Dailymotion";
    }

    return null;
}


/* =========================================================
   GLOBAL VARIABLES
========================================================= */

let currentURL = "";

let selectedFormat = "MP4";

let selectedQuality = "1080";

let processingTimer = null;


/* =========================================================
   VALID URL
========================================================= */

function isValidURL(value){

    try{

        const url =
            new URL(value);

        return(
            url.protocol === "http:" ||
            url.protocol === "https:"
        );

    }
    catch(error){

        return false;

    }

}


/* =========================================================
   START DOWNLOAD
========================================================= */

function startDownload(){

    const input =
        document.getElementById("urlInput");

    const url =
        input.value.trim();


    if(!url){

        return;

    }


    if(!isValidURL(url)){

        showToast(
            "Please enter a valid video link."
        );

        return;

    }


    const platform =
        detectPlatform(url);


    if(!platform){

        showToast(
            "Please enter a supported video link."
        );

        return;

    }


    currentURL = url;


    document
        .getElementById("result")
        .classList.remove("active");


    const processing =
        document.getElementById("processing");

    processing.classList.add("active");


    const processingText =
        document.getElementById("processingText");


    const messages = [

        "Detecting video...",

        "Reading video information...",

        "Checking available formats...",

        "Preparing download options..."

    ];


    let index = 0;


    processingText.textContent =
        messages[0];


    clearInterval(processingTimer);


    processingTimer =
        setInterval(function(){

            index++;


            if(index < messages.length){

                processingText.textContent =
                    messages[index];

            }

            else{

                clearInterval(processingTimer);

                finishProcessing();

            }

        },550);

}


/* =========================================================
   FINISH PROCESSING
========================================================= */

function finishProcessing(){

    document
        .getElementById("processing")
        .classList.remove("active");


    showResult();

}


/* =========================================================
   SHOW RESULT
========================================================= */

function showResult(){

    const result =
        document.getElementById("result");


    const preview =
        document.getElementById("videoPreview");


    const placeholder =
        document.getElementById("previewPlaceholder");


    const title =
        document.getElementById("videoTitle");


    placeholder.style.display =
        "flex";


    preview.classList.remove(
        "has-image"
    );


    title.textContent =
        "Your video";


    result.classList.add("active");


    result.scrollIntoView({

        behavior:"smooth",

        block:"center"

    });


    loadPreview();

}


/* =========================================================
   LOAD PREVIEW
========================================================= */

async function loadPreview(){

    const loading =
        document.getElementById("previewLoading");


    loading.classList.add("active");


    const API_ENDPOINT =
        "/api/resolve";


    try{

        const response =
            await fetch(API_ENDPOINT,{

                method:"POST",

                headers:{
                    "Content-Type":"application/json"
                },

                body:JSON.stringify({

                    url:currentURL

                })

            });


        if(!response.ok){

            throw new Error(
                "Backend unavailable"
            );

        }


        const data =
            await response.json();


        if(data.thumbnail){

            const image =
                document.getElementById(
                    "videoThumbnail"
                );


            image.src =
                data.thumbnail;


            image.onload =
                function(){

                    document
                        .getElementById(
                            "previewPlaceholder"
                        )
                        .style.display =
                        "none";


                    document
                        .getElementById(
                            "videoPreview"
                        )
                        .classList.add(
                            "has-image"
                        );

                };

        }


        if(data.title){

            document
                .getElementById(
                    "videoTitle"
                )
                .textContent =
                data.title;

        }


        loading.classList.remove("active");

    }
    catch(error){

        loading.classList.remove("active");

        document
            .getElementById(
                "previewPlaceholder"
            )
            .style.display =
            "flex";

    }

}


/* =========================================================
   QUALITY DROPDOWN
========================================================= */

function toggleQuality(){

    const menu =
        document.getElementById(
            "qualityMenu"
        );

    const button =
        document.getElementById(
            "qualityButton"
        );


    menu.classList.toggle("active");

    button.classList.toggle("open");

}


function selectQuality(format,quality){

    selectedFormat =
        format;

    selectedQuality =
        quality;


    document
        .getElementById(
            "selectedFormat"
        )
        .innerHTML =
        format +
        "&nbsp;&nbsp;" +
        quality;


    document
        .getElementById(
            "qualityMenu"
        )
        .classList.remove(
            "active"
        );


    document
        .getElementById(
            "qualityButton"
        )
        .classList.remove(
            "open"
        );

}


/* =========================================================
   ACTUAL DOWNLOAD REQUEST
========================================================= */

async function downloadSelected(){

    if(!currentURL){

        showToast(
            "Paste a video link first."
        );

        return;

    }


    const button =
        document.getElementById(
            "downloadButton"
        );


    const status =
        document.getElementById(
            "downloadStatus"
        );


    button.disabled =
        true;


    button.textContent =
        "Loading...";


    status.textContent =
        "Preparing your download...";


    status.classList.add(
        "active"
    );


    try{

        const response =
            await fetch(
                "/api/download",
                {

                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({

                        url:currentURL,

                        format:selectedFormat,

                        quality:selectedQuality

                    })

                }
            );


        if(!response.ok){

            throw new Error(
                "Download service unavailable"
            );

        }


        const data =
            await response.json();


        if(
            !data.downloadUrl
        ){

            throw new Error(
                "No download URL"
            );

        }


        const link =
            document.createElement("a");


        link.href =
            data.downloadUrl;


        link.target =
            "_blank";


        link.rel =
            "noopener";


        document.body.appendChild(link);


        link.click();


        link.remove();


        status.textContent =
            "Your download has started!";


    }
    catch(error){

        status.textContent =
            "Download service is not connected yet.";


        showToast(
            "Connect your download backend/API first."
        );

    }


    button.disabled =
        false;


    button.textContent =
        "Download";

}


/* =========================================================
   INPUT + CLEAR BUTTON
========================================================= */

const urlInput =
    document.getElementById(
        "urlInput"
    );


const clearInputButton =
    document.getElementById(
        "clearInput"
    );


let pasteTimer;


urlInput.addEventListener(
    "input",
    function(){

        const value =
            this.value.trim();


        /* Show X only when there is text */

        if(value){

            clearInputButton
                .classList.add("show");

        }
        else{

            clearInputButton
                .classList.remove("show");

        }


        clearTimeout(
            pasteTimer
        );


        /*
           Automatically process supported
           links after they are pasted.
        */

        if(
            isValidURL(value) &&
            detectPlatform(value)
        ){

            pasteTimer =
                setTimeout(
                    function(){

                        startDownload();

                    },
                    250
                );

        }

    }
);


/* =========================================================
   ENTER KEY
========================================================= */

urlInput.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Enter"){

            event.preventDefault();

            startDownload();

        }

    }
);


/* =========================================================
   CLOSE QUALITY MENU WHEN CLICKING OUTSIDE
========================================================= */

document.addEventListener(
    "click",
    function(event){

        const wrap =
            document.querySelector(
                ".quality-wrap"
            );


        if(
            wrap &&
            !wrap.contains(event.target)
        ){

            document
                .getElementById(
                    "qualityMenu"
                )
                .classList.remove(
                    "active"
                );


            document
                .getElementById(
                    "qualityButton"
                )
                .classList.remove(
                    "open"
                );

        }

    }
);

</script>

